version: "1.0"
mode: code

model:
  provider: openai
  baseURL: "https://openrouter.ai/api/v1"
  name: "openrouter/free"
  apiKey: "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"
  defaultHeaders:
    HTTP-Referer: "http://localhost:3080"
    X-Title: "DeepSeek Harness"

workspace:
  root: .

agents:
  - id: spec-analyst
    file: ./agents/spec-analyst.yml
  - id: archify-architect
    file: ./agents/archify-architect.yml
  - id: ponytail-reviewer
    file: ./agents/ponytail-reviewer.yml
  - id: skills-developer
    file: ./agents/skills-developer.yml
  - id: prompt-enricher
    file: ./agents/prompt-enricher.yml

# Связывание навыков в конвейер
workflows:
  spec_driven_build:
    steps:
      - run: prompt-enricher
        action: "Преврати запрос пользователя в профессиональный промпт и передай исполнителю"
      - run: spec-analyst
        action: "Составь ТЗ и список атомарных задач по spec-kit"
      - run: archify-architect
        action: "Сгенерируй C4 и sequence диаграммы системы через archify"
      - run: ponytail-reviewer
        action: "Проверь задачи на овер-инжиниринг по правилам ponytail"
      - run: skills-developer
        action: "Реализуй код по TDD с применением agent-skills"